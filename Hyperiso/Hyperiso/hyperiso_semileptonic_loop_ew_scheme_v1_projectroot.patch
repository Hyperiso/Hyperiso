 def test_packaged_c10_template_is_tree_first() -> None:
     source = _template_text("C10.cpp")
 
-    assert "semileptonic-c10-tree-first-full-4f-v9" in source
+    assert "semileptonic-c10-tree-first-full-4f-recipe" in source
