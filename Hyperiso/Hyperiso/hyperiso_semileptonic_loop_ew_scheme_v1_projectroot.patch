+def test_packaged_semileptonic_loop_templates_apply_ew_scheme_only_to_loop_branch() -> None:
+    for name in ("C9.cpp", "C10.cpp", "CP9.cpp", "CP10.cpp"):
+        source = _template_text(name)
+        assert "hyperiso_marty_semileptonic_loop_ew_charge" in source, name
+        assert "sqrt_s(G_F * sqrt_s(2)) * M_Z * sin_s(2 * theta_W)" in source, name
+        assert "hyperiso_marty_apply_semileptonic_loop_ew_scheme" in source, name
+
+    c9 = _template_text("C9.cpp")
+    cp9 = _template_text("CP9.cpp")
+    cp10 = _template_text("CP10.cpp")
+    c10 = _template_text("C10.cpp")
+
+    # Direct tree-level Z'/LQ matching must keep the physical alpha_em WET
+    # normalization; only the one-loop branch is rewritten.
+    assert "if (!hyperiso_marty_tree_level_matching)" in c9
+    assert "if (!hyperiso_marty_tree_level_matching)" in cp9
+    assert "if (!hyperiso_marty_tree_level_matching)" in cp10
+    assert "C10_full = hyperiso_marty_apply_semileptonic_loop_ew_scheme(C10_full);" in c10
