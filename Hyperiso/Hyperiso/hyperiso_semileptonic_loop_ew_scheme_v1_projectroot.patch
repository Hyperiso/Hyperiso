+++ b/pyhyperiso/assets/template/MARTY/C10.cpp
@@ -6,7 +6,20 @@ using namespace mty;
 using namespace std;
 using namespace sm_input;
 
-// HYPERISO_MARTY_TEMPLATE_ABI: semileptonic-c10-tree-first-full-4f-recipe-v14
+// One-loop semileptonic amplitudes are evaluated in the same tree-level EW
+// input scheme as the reduced SuperIso matching formulae.  Keep tree-level
+// BSM matching (notably direct Z' exchange) in the physical alpha_em WET
+// normalization: only loop expressions are reparameterized.
+Expr hyperiso_marty_semileptonic_loop_ew_charge() {
+    return sqrt_s(G_F * sqrt_s(2)) * M_Z * sin_s(2 * theta_W);
+}
+
+Expr hyperiso_marty_apply_semileptonic_loop_ew_scheme(Expr value) {
+    Replace(value, e_em, hyperiso_marty_semileptonic_loop_ew_charge());
+    return DeepRefreshed(value);
+}
+
